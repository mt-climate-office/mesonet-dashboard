    "@types/papaparse": "^5.5.2",
    "eslint": "^10.11.0",
    "maplibre-gl": "5.18.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
